{
  "name": "@akmleva/ml-service",
  "version": "1.0.0",
  "description": "AKMLEVA ML Service - Machine Learning microservice for travel recommendations and AI features",
  "main": "app/main.py",
  "scripts": {
    "start": "python app/main.py",
    "dev": "py -3 -m uvicorn app.main:app --host 0.0.0.0 --port 3002 --reload",
    "test": "pytest tests/ -v",
    "test:unit": "pytest tests/ -v -m unit",
    "test:integration": "pytest tests/ -v -m integration",
    "lint": "flake8 app/ tests/",
    "format": "black app/ tests/",
    "type-check": "mypy app/",
    "build": "python -m build",
    "install": "pip install -e .",
    "install:dev": "pip install -e .[dev]",
    "install:all": "pip install -e .[all]",
    "docker:build": "docker build -t akmleva/ml-service .",
    "docker:run": "docker run -p 3002:3002 akmleva/ml-service",
    "train:destinations": "python -m app.pipelines.train_destination_embeddings_runner",
    "export:from-web": "node ../scripts/export-wikivoyage-ml-features.mjs"
  },
  "keywords": [
    "travel",
    "ai",
    "machine-learning",
    "fastapi",
    "recommendation",
    "python"
  ],
  "author": "AKMLEVA Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luismccampos-beep/beta-app.git",
    "directory": "ml-service"
  },
  "bugs": {
    "url": "https://github.com/luismccampos-beep/beta-app/issues"
  },
  "homepage": "https://docs.akmleva.com",
  "engines": {
    "python": ">=3.10"
  },
  "dependencies": {
    "fastapi": "0.141.1",
    "uvicorn": "0.52.4",
    "pydantic": "2.13.5",
    "numpy": "2.5.2",
    "scikit-learn": "1.9.0",
    "scipy": "1.18.1",
    "pandas": "3.0.5",
    "python-dotenv": "1.2.3",
    "requests": "2.34.2"
  },
  "devDependencies": {
    "pytest": "9.1.1",
    "pytest-asyncio": "1.4.0",
    "black": "26.3.1",
    "flake8": "7.3.0",
    "mypy": "1.16.0",
    "pre-commit": "4.2.0"
  },
  "optionalDependencies": {
    "psycopg2-binary": "2.9.10",
    "sqlalchemy": "2.0.52",
    "redis": "5.3.0",
    "prometheus-client": "0.22.1"
  },
  "python": {
    "dependencies": [
      "fastapi>=0.141.0",
      "uvicorn[standard]>=0.52.0",
      "pydantic>=2.13.0",
      "numpy>=2.5.0",
      "scikit-learn>=1.9.0",
      "scipy>=1.18.0",
      "pandas>=3.0.0",
      "python-dotenv>=1.2.0",
      "requests>=2.34.0"
    ],
    "devDependencies": [
      "pytest>=9.1.0",
      "pytest-asyncio>=0.25.0",
      "black>=25.0.0",
      "flake8>=7.3.0",
      "mypy>=1.16.0",
      "pre-commit>=4.2.0"
    ],
    "optionalDependencies": {
      "db": [
        "psycopg2-binary>=2.9.10",
        "sqlalchemy>=2.0.50"
      ],
      "cache": [
        "redis>=5.3.0"
      ],
      "monitoring": [
        "prometheus-client>=0.22.0"
      ]
    }
  }
}
