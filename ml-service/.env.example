# Environment Configuration — all variables use the ML_SERVICE_ prefix,
# matching the env_prefix used in app/core/config.py. Without the prefix the
# values are ignored.

# Application
ML_SERVICE_APP_NAME=ML Service
ML_SERVICE_ENVIRONMENT=development   # production | development | staging
ML_SERVICE_DEBUG=false

# Server
ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8000

# Backend (AKMLEVA web app) base URL used for outbound integration calls
ML_SERVICE_BACKEND_URL=http://localhost:3002

# Security — REQUIRED in production. Sent by clients in the `x-api-key` header.
# When unset, the API refuses requests in production (fail closed) and allows
# them only in non-production environments.
ML_SERVICE_API_KEY=dev_ml_service_api_key_minimum_32_characters_long
ML_SERVICE_SECRET_KEY=change-me-to-a-random-secret-in-production

# CORS — explicit origins; never use "*" together with credentials
ML_SERVICE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:3002
ML_SERVICE_ALLOWED_METHODS=*
ML_SERVICE_ALLOWED_HEADERS=*

# LLMs
ML_SERVICE_GEMINI_API_KEY=your_gemini_api_key_here
ML_SERVICE_GEMINI_MODEL=gemini-2.0-flash
ML_SERVICE_TINY_AYA_API_URL=http://localhost:8080/v1
ML_SERVICE_TINY_AYA_API_KEY=

# ML model paths
ML_SERVICE_MODEL_DIR=models
ML_SERVICE_MODEL_PATH=models/model.pkl
ML_SERVICE_MODEL_NAME=recommender
ML_SERVICE_DATA_DIR=app/data
ML_SERVICE_CACHE_DIR=cache
ML_SERVICE_LOG_DIR=logs
ML_SERVICE_CONFIG_DIR=config

# Monitoring
ML_SERVICE_PROMETHEUS_PORT=9090
ML_SERVICE_GRAFANA_ENABLED=false

# Logging
ML_SERVICE_LOG_LEVEL=INFO
