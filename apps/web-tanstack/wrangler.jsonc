{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "akmleva-web",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true
  },
  "vars": {
    "DATABASE_DISABLED": "false",
    "PUBLIC_ONLY_MODE": "false",
    "VITE_BASE_URL": "https://akmleva.pt"
  },
  // Hyperdrive deve ser configurado via dashboard do Cloudflare ou adicionado aqui
  // com um ID real de recurso antes do deploy manual a partir deste arquivo.
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "routes": [
    {
      "pattern": "akmleva.pt",
      "custom_domain": true
    }
  ],
  "workers_dev": true
}
