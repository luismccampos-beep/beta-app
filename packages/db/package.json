{
  "name": "@akmleva/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "prisma": {
    "schema": "./prisma/schema.prisma"
  },
  "scripts": {
    "generate": "node ./scripts/prisma-with-fallback.mjs generate",
    "migrate:dev": "node ./scripts/prisma-with-fallback.mjs migrate dev",
    "migrate:deploy": "node ./scripts/prisma-with-fallback.mjs migrate deploy",
    "push": "node ./scripts/prisma-with-fallback.mjs db push",
    "seed": "npx tsx prisma/seed.ts",
    "reset": "node ./scripts/prisma-with-fallback.mjs migrate reset --force",
    "studio": "prisma studio",
    "resolve": "node ./scripts/resolve-failed-migrations.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg-worker": "^6.9.0",
    "@prisma/client": "6.17.1",
    "@prisma/pg-worker": "^6.9.0"
  },
  "devDependencies": {
    "prisma": "6.17.1",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
