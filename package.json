{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "akmleva",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "deploy": "wrangler deploy -c apps/web-tanstack/dist/server/wrangler.json",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "postinstall": "npm run generate -w @akmleva/db",
    "prisma:generate": "npm run generate -w @akmleva/db",
    "prisma:migrate": "npm run migrate:dev -w @akmleva/db",
    "prisma:studio": "npm run studio -w @akmleva/db",
    "db:push": "npm run push -w @akmleva/db",
    "db:migrate": "npm run migrate:deploy -w @akmleva/db",
    "db:resolve": "npm run resolve -w @akmleva/db",
    "db:seed": "npm run seed -w @akmleva/db",
    "db:reset": "npm run reset -w @akmleva/db",
    "db:studio": "npm run studio -w @akmleva/db",
    "test": "turbo test",
    "test:tanstack": "npm run test -w @akmleva/web-tanstack",
    "test:unit:tanstack": "npm run test:unit -w @akmleva/web-tanstack",
    "test:watch:tanstack": "npm run test:watch -w @akmleva/web-tanstack",
    "test:changed:tanstack": "npm run test:changed -w @akmleva/web-tanstack",
    "test:changed:coverage:tanstack": "npm run test:changed:coverage -w @akmleva/web-tanstack",
    "e2e:tanstack": "npm run e2e -w @akmleva/web-tanstack",
    "e2e:a11y:tanstack": "npm run e2e:a11y -w @akmleva/web-tanstack",
    "dev:tanstack": "npm run dev -w @akmleva/web-tanstack",
    "build:tanstack": "npm run build -w @akmleva/web-tanstack",
    "start:tanstack": "npm run preview -w @akmleva/web-tanstack",
    "type-check:tanstack": "npm run type-check -w @akmleva/web-tanstack",
    "lint:tanstack": "npm run lint -w @akmleva/web-tanstack",
    "data-pipeline": "npm run -w tools/data-pipeline"
  },
  "dependencies": {
    "@prisma/client": "6.17.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prisma": "6.17.1",
    "turbo": "^2.10.4",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "effect": "^3.22.1",
    "deepmerge-ts": "^8.0.0",
    "tar": "^7.5.22"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
